# Attestation identity
ro.product.device_for_attestation=TB323FU
ro.product.model_for_attestation=TB323FU
ro.product.name_for_attestation=TB323FU

# Device name
ro.product.marketname=Lenovo Legion Tab (8.8",5)

# Remote key provisioning
remote_provisioning.enable_rkpd=true
