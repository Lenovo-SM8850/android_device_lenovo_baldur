type vendor_proc_nvt_pen, fs_type, proc_type;

# Only vendor init applies the boot/selected pen type and always-on wake mode.
allow vendor_init vendor_proc_nvt_pen:file rw_file_perms;
# support_pen uses the shared touchscreen proc label.
allow vendor_init proc_tp:file rw_file_perms;
neverallow system_app vendor_proc_nvt_pen:file { write append };
