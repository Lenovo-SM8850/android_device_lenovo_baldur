// Device init

prebuilt_etc {
    name: "init.lenovo.baldur.rc",
    required: ["init.lenovo.common.rc"],
    src: "init.lenovo.baldur.rc",
    sub_dir: "init/hw",
    vendor: true,
}

// Device fstab.
prebuilt_etc {
    name: "fstab.qcom",
    src: "fstab.qcom",
    vendor: true,
    vendor_ramdisk_available: true,
}

// NVT pen
prebuilt_etc {
    name: "init.baldur.pen.rc",
    src: "init.baldur.pen.rc",
    sub_dir: "init",
    vendor: true,
}
